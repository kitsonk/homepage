{
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "deno run -A --env-file npm:astro dev",
    "build": "deno run -A --env-file npm:astro build",
    "build:posts": "deno run -A utils/build_posts.ts",
    "start": "deno run -A ./dist/server/entry.mjs"
  },
  "lint": { "rules": { "tags": ["recommended"] } },
  "fmt": { "lineWidth": 120 },
  "unstable": ["fmt-component"],
  "exclude": ["dist", ".astro", "public"],
  "imports": {
    "@/": "./",
    "@deno/astro-adapter": "npm:@deno/astro-adapter@^0.6.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
    "@deno/fresh_charts": "https://deno.land/x/fresh_charts@0.3.1/render.ts",
    "@deno/fresh_charts/utils": "https://deno.land/x/fresh_charts@0.3.1/utils.ts",
    "@deno/gfm": "jsr:/@deno/gfm@0.11.0",
    "@kitsonk/ga4": "jsr:/@kitsonk/ga4@0.1.0",
    "@std/assert": "jsr:/@std/assert@~1",
    "@std/front-matter": "jsr:/@std/front-matter@~1",
    "@std/media-types": "jsr:/@std/media-types@~1",
    "@std/path": "jsr:/@std/path@~1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.4",
    "astro": "npm:astro@^7.2.0",
    "prismjs": "npm:prismjs@1.30.0",
    "tailwindcss": "npm:tailwindcss@^4.2.4"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"]
  },
  "nodeModulesDir": "auto"
}
